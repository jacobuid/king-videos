<?xml version="1.0" encoding="utf-8"?>
<component name="MediaTile" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="updateContent"/>
    <field id="focusPercent" type="float" onChange="updateFocus"/>
    <field id="rowFocusPercent" type="float"/>
  </interface>
  <script type="text/brightscript" uri="MediaTile.brs"/>
  <children>
    <Poster id="border" width="234" height="265" uri="pkg:/images/search-card.png"/>
    <Poster id="art" translation="[3,3]" width="228" height="128" loadDisplayMode="scaleToFill"/>
    <Group id="progress" translation="[3,128]" visible="false">
      <Rectangle width="228" height="3" color="#555555"/>
      <Rectangle id="progressFill" width="0" height="3" color="#eec052"/>
    </Group>
    <Label id="title" translation="[14,139]" width="207" height="70" wrap="true" maxLines="2" vertAlign="top"/>
    <Label id="metadata" translation="[14,221]" width="148" height="28" color="#bfbfbf"/>
    <Poster id="ratingChip" translation="[166,222]" width="57" height="26" uri="pkg:/images/search-chip.png" visible="false"/>
    <Label id="rating" translation="[166,222]" width="57" height="26" horizAlign="center" vertAlign="center"/>
    <Group id="blocked" translation="[8,8]" visible="false">
      <Rectangle width="105" height="30" color="#721523"/>
      <Label width="105" height="30" text="Blocked" horizAlign="center" vertAlign="center" id="sizedLabel1"/>
    </Group>
  </children>
</component>
