<?xml version="1.0" encoding="utf-8"?>
<component name="HomeHero" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="renderItem"/>
    <field id="action" type="string" alwaysNotify="true"/>
    <field id="shelvesRequested" type="boolean" alwaysNotify="true"/>
    <field id="menuRequested" type="boolean" alwaysNotify="true"/>
    <function name="activate"/>
  </interface>
  <script type="text/brightscript" uri="HomeHero.brs"/>
  <children>
    <Poster id="art" translation="[375,55]" width="900" height="506" loadDisplayMode="scaleToFit"/>
    <Label id="eyebrow" translation="[1310,25]" width="535" height="30" text="Featured Presentation" color="#bfbfbf" font="font:SmallSystemFont"/>
    <Label id="title" translation="[1310,65]" width="535" height="105" wrap="true" maxLines="2" color="#f3cc57" font="font:LargeBoldSystemFont"/>
    <Label id="metadata" translation="[1310,180]" width="535" height="35" color="#cccccc" font="font:MediumSystemFont"/>
    <Label id="description" translation="[1310,235]" width="535" height="225" wrap="true" maxLines="8" color="#dddddd" font="font:MediumSystemFont"/>
    <Group id="buttons"/>
  </children>
</component>
