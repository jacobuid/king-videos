<?xml version="1.0" encoding="utf-8"?>
<component name="ProfilePinPage" extends="Group">
  <interface>
    <field id="profileName" type="string" onChange="updateTitle"/>
    <field id="message" type="string" alias="message.text"/>
    <field id="submittedPin" type="string" alwaysNotify="true"/>
    <field id="cancelled" type="boolean" alwaysNotify="true"/>
    <function name="activate"/>
    <function name="clearPin"/>
  </interface>
  <script type="text/brightscript" uri="ProfilePinPage.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="#000000"/>
    <Label id="subtitle" translation="[260,235]" width="1400" height="45" text="Profile Lock is currently on." horizAlign="center" color="#999999" font="font:MediumSystemFont"/>
    <Label id="title" translation="[180,300]" width="1560" height="90" wrap="true" maxLines="2" horizAlign="center" font="font:LargeBoldSystemFont"/>
    <Group id="boxes"/>
    <Label id="message" translation="[260,630]" width="1400" height="60" wrap="true" horizAlign="center" color="#f3cc57" font="font:MediumSystemFont"/>
    <ProfilePinKeyboard id="keyboard" translation="[750,720]"/>
    <Label id="hint" translation="[260,1000]" width="1400" height="40" text="Enter 4 digits to unlock. Press Back to choose another profile." horizAlign="center" color="#888888" font="font:SmallSystemFont"/>
  </children>
</component>
